doctype html
html(lang="en")
  head
    title #{title} — Anime Collection
    link(rel="stylesheet" href="/css/style.css")
  body
    header.site-header
      a.brand(href="/") 🎬 Anime Collection
      a.btn(href="/add") + Add anime
      if user
        a.btn(href="/user/logout") Logout #{user.username}
      else
        a.btn(href="/user/login") Login
    main.container
      block content
    footer.site-footer
      p built for Algonquin College by Abul Qasim